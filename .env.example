# ============================================================
#  竞赛辅助服务智能体 —— 环境配置模板
#  复制本文件为 .env 后按实际情况修改
#  copy .env.example .env
# ============================================================

# ---------- 基础 ----------
APP_NAME=竞赛辅助服务智能体
APP_ENV=dev
HOST=127.0.0.1
PORT=8000

# ---------- 数据库 ----------
# 默认 SQLite，开箱即用；生产可切换 MySQL / PostgreSQL
# SQLite:      sqlite:///./data/app.db
# MySQL:       mysql+pymysql://user:pass@127.0.0.1:3306/competition?charset=utf8mb4
# PostgreSQL:  postgresql+psycopg://user:pass@127.0.0.1:5432/competition
DATABASE_URL=sqlite:///./data/app.db

# ---------- 大模型 ----------
# provider 可选: deepseek | qwen | doubao | openai | ollama | mock
# mock = 不调用任何外部服务，使用内置抽取式回答（离线演示可用）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# 留空则使用 provider 默认地址
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 各 provider 默认值（一般无需修改，仅供查阅）
# deepseek : base=https://api.deepseek.com/v1        model=deepseek-chat
# qwen     : base=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# doubao   : base=https://ark.cn-beijing.volces.com/api/v3           model=<接入点ID>
# openai   : base=https://api.openai.com/v1          model=gpt-4o-mini
# ollama   : base=http://127.0.0.1:11434/v1          model=qwen2.5:7b

# ---------- 向量检索 ----------
# embedding 方式: local（内置，离线可用，零依赖） | api（调用大模型厂商 embedding 接口）
EMBEDDING_MODE=local
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512
# 混合检索权重
RETRIEVE_VECTOR_WEIGHT=0.5
RETRIEVE_BM25_WEIGHT=0.5
RETRIEVE_TOP_K=6
# 低于该分数的检索结果视为不相关（用于"答不出就说答不出"）
RETRIEVE_MIN_SCORE=0.20

# ---------- 路径 ----------
KNOWLEDGE_DIR=./data/knowledge
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# ---------- 安全 ----------
# 演示用简单口令；正式部署请修改
ADMIN_TOKEN=admin
